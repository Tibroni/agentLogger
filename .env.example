OBSERVABILITY_URL=http://localhost:3000
OBSERVABILITY_API_KEY=dev-api-key-change-me
DATABASE_URL=file:./dev.db

# Auto-instrumentation (used by import "agentlogger/auto")
AGENTLOGGER_PROJECT_ID=minimal-agent
AGENTLOGGER_FLUSH_INTERVAL_MS=3000

# Dashboard project filter — must match AGENTLOGGER_PROJECT_ID
NEXT_PUBLIC_OBSERVABILITY_PROJECT_ID=minimal-agent

# Optional: extra LLM hostnames (comma-separated)
# AGENTLOGGER_LLM_HOSTS=my-llm-proxy.internal

# Skip postinstall auto-setup in CI/monorepos
# AGENTLOGGER_SKIP_SETUP=1
