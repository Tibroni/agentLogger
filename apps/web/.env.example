# SQLite database for the dashboard (local file — no server install needed)
DATABASE_URL=file:./dev.db

OBSERVABILITY_API_KEY=dev-api-key-change-me
NEXT_PUBLIC_OBSERVABILITY_API_KEY=dev-api-key-change-me
# Leave unset in npm builds — CLI sets OBSERVABILITY_PROJECT_ID at dashboard launch.
# NEXT_PUBLIC_OBSERVABILITY_PROJECT_ID=your-project-name
