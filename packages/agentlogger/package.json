{
  "name": "agentlogger",
  "version": "1.1.1",
  "description": "Local-first AI agent observability — auto-trace LLM calls and tools, view runs in a local dashboard",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tibroni/agentLogger.git"
  },
  "homepage": "https://github.com/Tibroni/agentLogger#readme",
  "bugs": {
    "url": "https://github.com/Tibroni/agentLogger/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto/index.d.ts",
      "import": "./dist/auto/index.js"
    },
    "./middleware/http": {
      "types": "./dist/middleware/http.d.ts",
      "import": "./dist/middleware/http.js"
    }
  },
  "bin": {
    "agentlogger": "./bin/agentlogger.js"
  },
  "files": ["dist", "bin", "dashboard"],
  "scripts": {
    "build": "node ../../scripts/build-agentlogger-package.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node ./bin/setup.js --yes || true"
  },
  "dependencies": {},
  "devDependencies": {
    "@agentlogger/core": "workspace:*",
    "@agentlogger/sdk": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": ["ai", "agents", "observability", "tracing", "dashboard"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
