{
  "name": "agentlogger",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:dashboard": "pnpm --filter @agentlogger/web dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @agentlogger/web exec prisma generate",
    "db:migrate": "pnpm --filter @agentlogger/web exec prisma migrate dev",
    "db:push": "pnpm --filter @agentlogger/web exec prisma db push",
    "test:e2e": "pnpm build && pnpm --filter agentlogger-e2e test",
    "pack:sdk": "pnpm --filter @agentlogger/sdk build && pnpm --filter @agentlogger/sdk exec npm pack",
    "build:npm": "node scripts/build-agentlogger-package.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
